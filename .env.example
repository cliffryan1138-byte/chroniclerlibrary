# ---------------------------------------------------------------------------
# GitHub access
# ---------------------------------------------------------------------------
# Fine-grained personal access token with "Contents: Read and write" on all
# four Chronicles repos. Create at:
#   github.com -> Settings -> Developer settings -> Personal access tokens
#                 -> Fine-grained tokens -> Generate new token
# Repository access: select cliffryan1138-byte/war-chronicles,
#   waterline-chronicles, captains-cellar, chronicle-of-fear
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx

# GitHub account that owns the four site repos.
GITHUB_OWNER=cliffryan1138-byte

# ---------------------------------------------------------------------------
# Dashboard sign-in
# ---------------------------------------------------------------------------
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Users allowed to sign in, as JSON. Generate each passwordHash with:
#   npm run hash -- "their-password"
# "name" is stamped onto posts as the author and into the git commit message.
DASHBOARD_USERS=[{"username":"cliff","name":"Cliff Ryan","passwordHash":"..."},{"username":"rebecca","name":"Rebecca","passwordHash":"..."}]
